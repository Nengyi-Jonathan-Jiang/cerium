// An example of loops
// Here we compute the Collatz sequence for a number

    // Set up
    mov i r5 <- EVEN_CASE
    mov i r6 <- LOOP
    mov i r7 <- END

    // Take input
    input -> r1

LOOP:
    // Display current
    output <- r1
    // Check base case (n == 1)
    mov i r3 <- 1
    sub i r2 <- r1 - r3
    jmp r7 if i r2 == 0

    // Check parity
    mov i r2 <- 2
    mod i r2 <- r1 % r2
    jmp r5 if i r2 == 0

    // Odd case: n -> 3n + 1
    mov i r2 <- 3
    mul i r1 <- r1 * r2
    mov i r2 <- 1
    add i r1 <- r1 + r2
    jmp r6 always

EVEN_CASE:
    // Even case: n -> n / 2
    mov i r2 <- 1
    shr i r1 <- r1 >> r2
    jmp r6 always

END:
    halt
